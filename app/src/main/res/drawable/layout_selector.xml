<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:start="@dimen/_4sdp" android:end="@dimen/_4sdp" android:top="@dimen/_4sdp" android:bottom="@dimen/_4sdp">
                <shape>
                    <solid android:color="@color/white" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:start="0dp" android:end="0dp" android:top="0dp" android:bottom="0dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

