<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.fragments.TrainingFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="false"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:background="@color/gray_box">

                <ImageView
                    android:id="@+id/ftBanner"
                    android:scaleType="fitXY"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <TextView
                    android:id="@+id/ftTitleTxt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:elevation="@dimen/_1sdp"
                    android:textSize="@dimen/_16ssp"
                    android:paddingHorizontal="@dimen/_24sdp"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:textColor="@color/white"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:backgroundTint="@color/black"
                android:background="@null">

                <EditText
                    android:id="@+id/ftSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_2sdp"
                    android:hint="@string/type_here"
                    android:textColorHint="#AAAAAA"
                    style="@style/EditTextCustomStyle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/ftSearch"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@null"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ftRecycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_12sdp" />

            <TextView
                android:id="@+id/ftMessage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/no_data_found"
                android:visibility="gone"
                android:fontFamily="@font/poppins_light"
                android:textStyle="bold"
                android:textSize="@dimen/_11ssp"
                android:gravity="center"
                android:textColor="@color/gray_text"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>